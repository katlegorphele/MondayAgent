# ═══════════════════════════════════════
# REQUIRED — set these in Railway dashboard
# ═══════════════════════════════════════

# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Your Telegram numeric user ID (from @userinfobot)
TELEGRAM_ALLOWED_USERS=

# Your girlfriend's Telegram numeric user ID (if she'll use Telegram too)
# TELEGRAM_ALLOWED_USERS=123456789,987654321

# Webhook URL (set AFTER Railway gives you a domain)
# TELEGRAM_WEBHOOK_URL=https://your-app.railway.app/telegram
# TELEGRAM_WEBHOOK_SECRET=<generate with: openssl rand -hex 32>

# ── Provider API keys (pick one) ──
DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# ── Optional ──
# PORT=3000
